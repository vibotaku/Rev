# Copy to .env and adjust. deploy/install.sh does this for you.

# Required: password for the bundled Postgres (generate with `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me

# URL people use to reach Rev. Used in invite links and agent setup instructions.
# Use https://... when serving through Caddy (secure cookies are enabled automatically).
PUBLIC_URL=http://rev.lan:8080

# Where data lives on the host. Point REV_MEDIA_DIR at a large disk for videos.
REV_DB_DIR=./data/postgres
REV_MEDIA_DIR=./data/rev

# Port Rev listens on (set REV_BIND=127.0.0.1 when only Caddy should reach it).
REV_PORT=8080
REV_BIND=0.0.0.0

# Largest single upload, in MB.
MAX_UPLOAD_MB=2048

# Optional: fix the first-run setup token instead of reading it from the log.
REV_SETUP_TOKEN=

# Optional Active Directory sign-in (docs/active-directory.md). Easiest: configure it in Admin → Active Directory.
# These variables are only imported on first start, while the database has no AD settings yet.
LDAP_URL=
# LDAP_URL=ldaps://dc01.corp.example.com,ldaps://dc02.corp.example.com
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Group (name or DN) whose members may sign in; empty = any enabled account.
LDAP_ALLOWED_GROUP=
# CA certificate for LDAPS, placed in ./config (mounted at /config).
LDAP_CA_FILE=
# LDAP_CA_FILE=/config/ldap-ca.pem

# Optional HTTPS via Caddy (`docker compose --profile tls up -d`).
# A public domain gets a Let's Encrypt certificate; for LAN-only names see deploy/Caddyfile.
REV_DOMAIN=
